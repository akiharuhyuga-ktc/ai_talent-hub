# Entra ID (Azure AD) の認証に使う設定値。
# 本番では Public Client + "Allow public client flows" = Yes のアプリ登録が必要。
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# 自前バックエンド API のカスタムスコープ。Phase 1（バックエンド未着手）では空でよい。
# Phase 2 でバックエンドプロキシを建てる際に、Azure AD の「Expose an API」でスコープを
# 作成してから `api://YOUR_CLIENT_ID/access_as_user` を設定する。
VITE_API_SCOPE=

# AI proxy (AWS Lambda Function URL) のベース URL。
# 例: https://dev-bizport.kinto-mobility.jp
# 空文字なら同一オリジン (/api/...) に向けて発信し、dev では MSW が傍受する。
VITE_API_BASE_URL=

# MSW (ブラウザ側モックワーカー) を起動するかどうかの補助フラグ。
#   "true"      production ビルド (preview / Tauri release) でも MSW を起動する
#   "false"/未設定  dev は常に MSW 起動 / production は起動しない (= 通常運用)
#
# 注: dev 中の「デモ応答 ↔ 実 Lambda」「demo-members ↔ members」の切替は
#     サイドバーの画面トグル (DemoModeContext) が master。
#     本フラグは MSW を起動するかどうかしか制御しない。
VITE_DEMO_MODE=false
